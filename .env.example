# Mock mode: no network calls, zero credits. Use this for all dev and tests.
VITE_MOCK_MODE=true

# Provider selection. Gemini is the live conversation model; speech is Sarvam.
VITE_LLM_PROVIDER=gemini
VITE_STT_PROVIDER=sarvam
VITE_TTS_PROVIDER=sarvam
# Verified callable with schema-constrained output. gemini-2.5-flash is listed
# by the API but returns 404 on some keys, so the adapter falls back automatically.
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# The proxy that holds your keys. No key ever appears in the extension bundle.
VITE_PROXY_URL=http://127.0.0.1:8787

# Spoken replies cost money per character, so they are opt-in.
VITE_SPOKEN_REPLIES=false

# Only needed if you bypass the proxy. Prefer the proxy.
# VITE_GEMINI_KEY=
# VITE_CLAUDE_KEY=
# VITE_OPENAI_KEY=