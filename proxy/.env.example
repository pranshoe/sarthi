# Copy to proxy/.env and fill in. NEVER commit the real file.
# Only this machine's proxy reads these. The extension bundle has no keys.

# Sarvam: speech output (TTS). Get from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Gemini: conversation. Free tier, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hard spend ceiling in INR. Requests are refused once reached.
SPEND_CAP_INR=100

PORT=8787